# Local PostgreSQL-first setup
ENVIRONMENT=development
PORT=8080

# Prefer DATABASE_URL. SUPABASE_DB_URL is legacy fallback only.
DATABASE_URL=postgresql://postgres:your-local-password@localhost:5432/ipv6ftp?sslmode=disable
SUPABASE_DB_URL=

JWT_SECRET=replace-with-32-byte-base64-secret
CORS_ORIGINS=*

BCRYPT_COST=12
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=50

# TURN (local/default)
TURN_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
METERED_API_KEY=
METERED_APP_NAME=
METERED_DOMAIN=

# Redis optional: leave empty to use in-memory cache
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0

# Call setup: set a distinct secret and a reachable public host where needed.
CALL_CODE_PEPPER=
APP_LINK_BASE_URL=
RENDEZVOUS_UDP_ADDR=[::]:3478
RENDEZVOUS_PUBLIC_HOST=
RENDEZVOUS_PUBLIC_PORT=3478

# Account recovery (all-or-nothing; leave blank to disable /api/v2 recovery + email routes)
# RECOVERY_PEPPER: random string, 16+ chars. EMAIL_PAYLOAD_KEY: base64 of 32 random bytes.
RECOVERY_PEPPER=
EMAIL_PAYLOAD_KEY=
EMAIL_PAYLOAD_KEY_VERSION=1

# Device enrollment (Noise IK). Optional; needs the account-security secrets above.
# NOISE_STATIC_KEY: base64 of 32 random bytes (server X25519 private key). NOISE_KEY_ID: label phones pin, e.g. k1.
NOISE_STATIC_KEY=
NOISE_KEY_ID=
