# Local PostgreSQL-first setup
ENVIRONMENT=development
PORT=8080

# Prefer DATABASE_URL. SUPABASE_DB_URL is legacy fallback only.
DATABASE_URL=postgresql://postgres:your-local-password@localhost:5432/ipv6ftp?sslmode=disable
SUPABASE_DB_URL=

JWT_SECRET=replace-with-32-byte-base64-secret
CORS_ORIGINS=*

BCRYPT_COST=12
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=50

# TURN (local/default)
TURN_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
METERED_API_KEY=
METERED_APP_NAME=
METERED_DOMAIN=

# Redis optional: leave empty to use in-memory cache
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0
