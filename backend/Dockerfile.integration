# Match the repository's Go module toolchain and prevent automatic downloads.
FROM golang:1.25-alpine
ENV GOTOOLCHAIN=local
WORKDIR /workspace/backend

RUN apk add --no-cache postgresql-client

COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY migrations/ ./migrations/
COPY db/ ./db/
COPY db/schema/pg_service.conf /workspace/backend/db/schema/pg_service.conf
COPY testdata/ ./testdata/

COPY scripts/integration-runner.sh /usr/local/bin/integration-runner.sh
CMD ["sh", "/usr/local/bin/integration-runner.sh"]
