# Copy to an ignored .env or provide values through the deployment environment.
# Never place credentials in Expo public configuration.
ENVIRONMENT=development
PORT=8080
# Application database only. Do not put the automated-test role or test DB here.
DATABASE_URL=
# Automated PostgreSQL test-runner configuration is not implemented yet.
# Keep test credentials separate from this application environment; do not use
# MIGRATOR_DATABASE_URL or IPV6FTP_ISOLATED_TEST_DATABASE_URL with the main DB.
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=
CALL_CODE_PEPPER=
CORS_ORIGINS=
BCRYPT_COST=12
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=50
APP_LINK_BASE_URL=
RENDEZVOUS_UDP_ADDR=[::]:3478
RENDEZVOUS_PUBLIC_HOST=
RENDEZVOUS_PUBLIC_PORT=3478
# Optional legacy relay configuration; leave blank unless configured.
TURN_URL=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
METERED_API_KEY=
METERED_APP_NAME=
METERED_DOMAIN=

# Account recovery (all-or-nothing; leave blank to disable /api/v2 recovery + email routes)
# RECOVERY_PEPPER: random string, 16+ chars. EMAIL_PAYLOAD_KEY: base64 of 32 random bytes.
RECOVERY_PEPPER=
EMAIL_PAYLOAD_KEY=
EMAIL_PAYLOAD_KEY_VERSION=1

# Device enrollment (Noise IK). Optional; needs the account-security secrets above.
# NOISE_STATIC_KEY: base64 of 32 random bytes (server X25519 private key). NOISE_KEY_ID: label phones pin, e.g. k1.
NOISE_STATIC_KEY=
NOISE_KEY_ID=
# Optional authenticated key rotation. Use a base64 SEC1 P-256 private key and canonical HTTPS origin.
ENROLLMENT_ROTATION_SIGNER=
ENROLLMENT_ROTATION_ORIGIN=
ENROLLMENT_ROTATION_EPOCH=
ENROLLMENT_PREVIOUS_KEY=
ENROLLMENT_PREVIOUS_KEY_ID=
# V1 credential issuance and single-instance public authentication budgets.
V1_CREDENTIAL_ISSUANCE=staging
PUBLIC_AUTH_IP_PER_MINUTE=10
PUBLIC_AUTH_SCOPE_PER_MINUTE=5
