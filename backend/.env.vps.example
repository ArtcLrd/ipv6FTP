# Ubuntu/VPS setup
ENVIRONMENT=production
PORT=8080

# Same keys as local; only values change.
DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5432/ipv6ftp?sslmode=disable
SUPABASE_DB_URL=

JWT_SECRET=replace-with-32-byte-base64-secret
CORS_ORIGINS=https://your-app-domain.com,exp://*,http://localhost:8081

BCRYPT_COST=12
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=50

# TURN on VPS (self-hosted or provider)
TURN_URL=turn:your-domain.com:3478
TURN_USERNAME=turn_user
TURN_CREDENTIAL=turn_password
TURN_SECRET=
METERED_API_KEY=
METERED_APP_NAME=
METERED_DOMAIN=

# Optional Redis
REDIS_URL=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
