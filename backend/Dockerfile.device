# Disposable device-test backend image. Matches the repository's Go module
# toolchain and prevents automatic toolchain downloads.
FROM golang:1.25-alpine
ENV GOTOOLCHAIN=local
WORKDIR /workspace/backend

COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY migrations/ ./migrations/

RUN go build -o /usr/local/bin/ipv6ftp-api ./cmd/api

COPY scripts/device-runner.sh /usr/local/bin/device-runner.sh
CMD ["sh", "/usr/local/bin/device-runner.sh"]
